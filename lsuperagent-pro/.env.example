NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=preview

# OAuth social login (Google, Microsoft, Apple)
#
# No extra browser env var is required. Provider client IDs and secrets stay in
# the Supabase project only and must never reach browser code.
#
# Configure each provider in Supabase Dashboard -> Authentication -> Providers.
# Provider callback URL: https://<project-ref>.supabase.co/auth/v1/callback
# Then add every deployed origin under Authentication -> URL Configuration
# -> Redirect URLs, otherwise the provider returns the user to a blocked URL.
